{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softdata.com.ng/schemas/education/technical_colleges.schema.json",
  "title": "Nigeria Technical Colleges (NBTE Directory Snapshot)",
  "description": "Row-level snapshot of the official NBTE Technical Colleges directory.",
  "type": "array",
  "minItems": 115,
  "maxItems": 115,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "ownership_type", "state_id", "country_code"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "name": {"type": "string", "minLength": 1},
      "ownership_type": {"type": "string", "enum": ["federal", "state", "private"]},
      "state_id": {"type": "string", "minLength": 1},
      "country_code": {"const": "NG"}
    }
  }
}
