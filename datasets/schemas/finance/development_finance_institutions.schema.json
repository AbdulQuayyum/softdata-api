  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://softdata-api.local/schemas/finance/development_finance_institutions.schema.json","title":"Nigeria Development Finance Institutions","type":"array","minItems":8,"maxItems":8,"uniqueItems":true,
