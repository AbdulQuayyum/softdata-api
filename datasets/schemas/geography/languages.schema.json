{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softdata-api.local/schemas/geography/languages.schema.json",
  "title": "World Languages",
  "description": "Schema for the world-languages dataset compiled from the Unicode CLDR 48.2.0 English language-name manifest.",
  "type": "array",
  "minItems": 633,
  "maxItems": 633,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z]{2,3}$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
