# Application Environment
APP_ENV=development

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_REQUEST_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_BODY_LIMIT=1048576
SERVER_ALLOWED_ORIGINS=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/softdata?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_CONNECTION_LIFETIME=30m
DATABASE_MAX_CONNECTION_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=10s

# Redis
REDIS_URL=
REDIS_ADDRESS=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=10
REDIS_KEY_PREFIX=

# Security
AUTH_TOKEN_SECRET=replace-with-a-secure-secret-value-of-at-least-32-bytes
JWT_ISSUER=softdata-api
JWT_AUDIENCE=softdata-api
ANONYMOUS_ID_SECRET=replace-with-a-secure-secret-value-of-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Rate Limits
# Short-window request enforcement values.
ANONYMOUS_RATE_LIMIT=60
API_KEY_RATE_LIMIT=300
DATASET_DOWNLOAD_RATE_LIMIT=10
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_FAIL_OPEN=true

# Usage
# Monthly allowance for API-key usage tracking.
API_KEY_MONTHLY_LIMIT=50000

# Datasets
DATASETS_PATH=datasets
